# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=pgsql
# Preferred: one connection string, any provider (Neon: use the DIRECT, non-pooled string).
DB_URL=
DB_SSLMODE=require
# Or discrete values:
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Never commit real secrets.
