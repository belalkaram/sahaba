# Frontend Environment Configuration
NEXT_PUBLIC_APP_NAME="Sahaba"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
PORT=3000

# Google Workspace & Cloud Services (Google Meet & Google Drive)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OD-20: show demo accounts on the login page.
# Unset: shown in development; in production the switch in /platform/settings decides (off by default).
# "true" / "false" force it on or off regardless of the switch.
NEXT_PUBLIC_DEMO_LOGIN=
